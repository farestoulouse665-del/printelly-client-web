# Application
APP_ENV=development
ENABLE_API_DOCS=true
PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
SIGNING_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_64_CARACTERES
ADMIN_TOKEN=REMPLACER_PAR_UN_JETON_ADMIN_ALEATOIRE
TRUST_PROXY_HEADERS=true

# BiRefNet ONNX local — le modèle n’est jamais téléchargé par une requête client
BACKGROUND_MODEL_PATH=/models/background-removal.onnx
BACKGROUND_MODEL_SHA256=REMPLACER_PAR_LE_SHA256_APPROUVE_DU_MODELE
BACKGROUND_MODEL_NAME=BiRefNet-general
BACKGROUND_MODEL_VERSION=approved-local
BACKGROUND_PIPELINE_VERSION=transferlab-birefnet-v3
BACKGROUND_DEVICE=auto
BACKGROUND_MODEL_INPUT_SIZE=1024
BACKGROUND_PIPELINE_V2_ENABLED=true
ONNX_INTRA_OP_THREADS=0
MAX_CONCURRENT_JOBS=1
INFERENCE_TILE_SIZE=2048
INFERENCE_TILE_OVERLAP=192
LARGE_IMAGE_THRESHOLD_PIXELS=16000000

# Uploads et conservation
MAX_UPLOAD_MB=150
MAX_IMAGE_PIXELS=120000000
MAX_BATCH_FILES=25
UPLOAD_CHUNK_MB=8
TEMP_DIR=/tmp/background-removal
TEMP_TTL_SECONDS=1800
RETENTION_DAYS_GUEST=7
RETENTION_DAYS_USER=90
DELETION_GRACE_HOURS=24
MAINTENANCE_INTERVAL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=300
ANTIVIRUS_COMMAND=
# PDF/AI-PDF, SVG et PSD sont convertis localement dans le conteneur non privilégié.
ALLOW_VECTOR_CONVERSION=true

# PostgreSQL
POSTGRES_DB=transferlab
POSTGRES_USER=transferlab
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_POSTGRES
DATABASE_URL=postgresql+psycopg://transferlab:REMPLACER_PAR_UN_MOT_DE_PASSE_POSTGRES@postgres:5432/transferlab

# Redis / RQ
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=background-removal
JOB_TIMEOUT_SECONDS=1800
JOB_EAGER=false

# Stockage privé local (compatible avec un volume Docker)
STORAGE_BACKEND=local
STORAGE_ROOT=/data/objects
SIGNED_URL_TTL_SECONDS=900

# Tarification DTF en DZD
PRICE_PER_SQUARE_CM_DZD=0.55
MINIMUM_LINE_ITEM_DZD=250
DEFAULT_DELIVERY_DZD=600

# Frontend Next.js
NEXT_PUBLIC_API_BASE_URL=/api/v1

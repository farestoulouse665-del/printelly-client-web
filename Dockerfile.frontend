FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY index.html app.js styles.css background-removal-api.js background-color-selection.js background-quality.js background-print-export.js background-remover.js background-remover.css manifest.webmanifest sw.js /usr/share/nginx/html/
EXPOSE 80
